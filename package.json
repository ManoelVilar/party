{
  "name": "party",
  "version": "0.4.1",
  "description": "Espa\u00e7o virtual em pixel art (isom\u00e9trico) para festas, encontros e reuni\u00f5es, com voz e v\u00eddeo por proximidade.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "lint": "node scripts/lint.mjs",
    "serve": "python3 -m http.server 8765",
    "test": "bash tests/run.sh",
    "test:rules": "node tests/rules/rules.test.cjs",
    "test:all": "npm run check && npm run lint && npm run test:rules && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "targaryen": "^3.1.0"
  }
}
